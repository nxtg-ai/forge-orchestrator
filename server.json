  },
  "version": "1.6.0",
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "forge-orchestrator",
      "version": "1.6.0",
      "transport": {
        "type": "stdio",
        "command": "forge",
        "args": ["mcp"]
