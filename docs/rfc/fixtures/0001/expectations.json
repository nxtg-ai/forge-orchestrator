{
  "rfc": "RFC-0001 \u2014 Schema-Version Handshake for .forge/ Cross-Repo Artifacts",
  "spec_section": "3.2.1 (supported-version comparison) + 3.2 (compatibility rules)",
  "absent_version_baseline": "1.0.0",
  "first_versioned_release": "1.1.0",
  "known_event_types": [
    "plan_created",
    "task_created",
    "task_assigned",
    "task_started",
    "task_completed",
    "task_failed",
    "files_locked",
    "files_unlocked",
    "knowledge_captured",
    "governance_check",
    "state_reconciled",
    "tool_detected",
    "quality_gate_passed",
    "quality_gate_failed"
  ],
  "cases": [
    {
      "id": "state-absent-field-accepted-as-1.0.0",
      "artifact": "state",
      "fixture": "state/v1_0_0_absent_field.json",
      "supported_version": "1.1.0",
      "expected_file_version": "1.0.0",
      "expected_verdict": "ACCEPT",
      "why": "Every .forge/ directory written up to forge v1.5.2 has no state_schema field. A reader that requires it breaks every existing project."
    },
    {
      "id": "state-baseline-exact-match",
      "artifact": "state",
      "fixture": "state/v1_1_0_baseline.json",
      "supported_version": "1.1.0",
      "expected_file_version": "1.1.0",
      "expected_verdict": "ACCEPT",
      "why": "First versioned release reading its own output."
    },
    {
      "id": "state-minor-ahead-downgrade-tolerated",
      "artifact": "state",
      "fixture": "state/v1_2_0_minor_ahead.json",
      "supported_version": "1.1.0",
      "expected_file_version": "1.2.0",
      "expected_verdict": "ACCEPT_FORWARD",
      "expected_unknown_fields": [
        "provenance_ledger"
      ],
      "why": "Downgrade case, MINOR: an older reader meets a newer file. Additive discipline means this must keep working \u2014 the unknown root field is ignored, not fatal."
    },
    {
      "id": "state-major-ahead-refused",
      "artifact": "state",
      "fixture": "state/v2_0_0_major_ahead.json",
      "supported_version": "1.1.0",
      "expected_file_version": "2.0.0",
      "expected_verdict": "REFUSE",
      "expected_message_contains": [
        "2.0.0",
        "1.1.0"
      ],
      "why": "Downgrade case, MAJOR: task_summary was renamed to task_counts. Reader must refuse loudly and name both versions \u2014 never silently return zeroed data."
    },
    {
      "id": "state-file-older-major-refused",
      "artifact": "state",
      "fixture": "state/v1_1_0_baseline.json",
      "supported_version": "2.0.0",
      "expected_file_version": "1.1.0",
      "expected_verdict": "REFUSE",
      "expected_message_contains": [
        "1.1.0",
        "2.0.0"
      ],
      "why": "Reader built for a later major cannot assume the older shape is a subset. Distinct message; the only case a future migration step could replace."
    },
    {
      "id": "events-mixed-major-ahead-record-quarantined",
      "artifact": "events",
      "fixture": "events/v1_1_0_mixed_major_ahead.jsonl",
      "supported_version": "1.1.0",
      "expected_verdict": "ACCEPT_PARTIAL",
      "expected_parsed": 2,
      "expected_skipped": 0,
      "expected_refused": 1,
      "expected_versions_seen": [
        "1.1.0",
        "2.0.0"
      ],
      "expected_refused_versions": [
        "2.0.0"
      ],
      "why": "Codex re-gate round 2 counterexample. A major-ahead record appended after compatible history must NOT be silently trusted because the log opened at 1.1.0. Per-record comparison quarantines it and counts it; the compatible history stays readable."
    },
    {
      "id": "events-mixed-minor-ahead-record-tolerated",
      "artifact": "events",
      "fixture": "events/v1_1_0_mixed_minor_ahead.jsonl",
      "supported_version": "1.1.0",
      "expected_verdict": "ACCEPT_FORWARD",
      "expected_parsed": 3,
      "expected_skipped": 0,
      "expected_refused": 0,
      "expected_versions_seen": [
        "1.1.0",
        "1.2.0"
      ],
      "expected_unknown_variants": [
        "provenance_recorded"
      ],
      "why": "The mirror case: a minor-ahead record mid-log is additive, so all three records parse. Batch reports ACCEPT_FORWARD because at least one record is ahead."
    },
    {
      "id": "events-mixed-all-three-classes",
      "artifact": "events",
      "fixture": "events/v1_1_0_mixed_all_three.jsonl",
      "supported_version": "1.1.0",
      "expected_verdict": "ACCEPT_PARTIAL",
      "expected_parsed": 3,
      "expected_skipped": 1,
      "expected_refused": 1,
      "expected_versions_seen": [
        "1.1.0",
        "1.2.0",
        "2.0.0"
      ],
      "expected_refused_versions": [
        "2.0.0"
      ],
      "expected_unknown_variants": [
        "provenance_recorded"
      ],
      "why": "All three defect classes in one log, with a baseline record AFTER the major-ahead one \u2014 proves the reader does not stop at the first incompatible record and does not let position determine the verdict."
    },
    {
      "id": "events-absent-field-accepted-as-1.0.0",
      "artifact": "events",
      "fixture": "events/v1_0_0_absent_field.jsonl",
      "supported_version": "1.1.0",
      "expected_verdict": "ACCEPT",
      "expected_parsed": 3,
      "expected_skipped": 0,
      "why": "Pre-RFC event logs carry no per-record v.",
      "expected_versions_seen": [
        "1.0.0"
      ],
      "expected_refused": 0
    },
    {
      "id": "events-unknown-variant-not-fatal",
      "artifact": "events",
      "fixture": "events/v1_2_0_unknown_variant.jsonl",
      "supported_version": "1.1.0",
      "expected_verdict": "ACCEPT_FORWARD",
      "expected_parsed": 3,
      "expected_skipped": 0,
      "expected_unknown_variants": [
        "provenance_recorded"
      ],
      "why": "The core G-05 hazard: a new EventType variant must map to the catch-all, not error the batch. Without #[serde(other)], this fixture is what turns an old dashboard blank.",
      "expected_versions_seen": [
        "1.2.0"
      ],
      "expected_refused": 0
    },
    {
      "id": "events-corrupt-line-skipped-and-counted",
      "artifact": "events",
      "fixture": "events/v1_1_0_corrupt_line.jsonl",
      "supported_version": "1.1.0",
      "expected_verdict": "ACCEPT",
      "expected_parsed": 3,
      "expected_skipped": 1,
      "why": "One truncated line must not zero out the history. Skip and count, report the count.",
      "expected_versions_seen": [
        "1.1.0"
      ],
      "expected_refused": 0
    },
    {
      "id": "events-major-ahead-refused",
      "artifact": "events",
      "fixture": "events/v2_0_0_major_ahead.jsonl",
      "supported_version": "1.1.0",
      "expected_verdict": "REFUSE",
      "why": "Every record is major-ahead, so nothing is readable by this reader and the BATCH refuses. Contrast with the mixed fixtures: whole-log refusal is correct only when no compatible record survives.",
      "expected_versions_seen": [
        "2.0.0"
      ],
      "expected_parsed": 0,
      "expected_skipped": 0,
      "expected_refused": 2,
      "expected_refused_versions": [
        "2.0.0"
      ]
    },
    {
      "id": "events-non-object-lines-skipped-not-fatal",
      "artifact": "events",
      "fixture": "events/v1_1_0_non_object_lines.jsonl",
      "supported_version": "1.1.0",
      "expected_verdict": "ACCEPT",
      "expected_parsed": 2,
      "expected_skipped": 4,
      "expected_refused": 0,
      "expected_versions_seen": [
        "1.1.0"
      ],
      "why": "Codex re-gate round 3. `[]`, `\"str\"`, `123` and `null` are all VALID JSON but are not records; rev 3 only caught json.JSONDecodeError, so these reached rec.get and crashed the whole batch with AttributeError \u2014 violating the one-bad-record isolation rule. Structural malformation is data damage: skipped and counted, never fatal."
    },
    {
      "id": "events-malformed-version-skipped-not-fatal",
      "artifact": "events",
      "fixture": "events/v1_1_0_malformed_version.jsonl",
      "supported_version": "1.1.0",
      "expected_verdict": "ACCEPT",
      "expected_parsed": 2,
      "expected_skipped": 3,
      "expected_refused": 0,
      "expected_versions_seen": [
        "1.1.0"
      ],
      "why": "Adjacent invariant found by self-probe, not reported by Codex: a non-string v (2), a non-numeric v ('1.x.0') and a two-part v ('1.1') each crashed parse_version. A record that cannot be placed on the version axis is malformed data, so it is SKIPPED \u2014 not REFUSED, which would wrongly imply a readable-but-too-new record."
    },
    {
      "id": "state-non-object-document-is-malformed",
      "artifact": "state",
      "fixture": "state/malformed_non_object.json",
      "supported_version": "1.1.0",
      "expected_verdict": "MALFORMED",
      "why": "The same crash class in the state path, which Codex did not report: read_state called doc.get on a decoded list. A state.json that is not a versioned object is unreadable \u2014 reported as MALFORMED, distinct from REFUSE (readable but too new)."
    },
    {
      "id": "state-non-string-version-is-malformed",
      "artifact": "state",
      "fixture": "state/malformed_version_type.json",
      "supported_version": "1.1.0",
      "expected_verdict": "MALFORMED",
      "why": "state_schema present but not a semver string. Must be reported, not raised."
    }
  ]
}
